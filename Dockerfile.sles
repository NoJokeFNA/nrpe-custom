# syntax=docker/dockerfile:1
ARG SLES_BASE_IMAGE=registry.suse.com/bci/bci-base:15.4
FROM ${SLES_BASE_IMAGE}

COPY scripts/setup-sles-repositories.sh scripts/setup-sles-media.sh /opt/nrpe-build/
COPY packaging/sles15sp4-backports.asc /opt/nrpe-build/backports.asc
COPY packaging/sles15sp4-suse.asc /opt/nrpe-build/suse.asc
RUN --mount=from=nrpe_sles_media,target=/mnt/nrpe-sles-media,readonly \
    rpm --import /opt/nrpe-build/backports.asc /opt/nrpe-build/suse.asc \
    && bash /opt/nrpe-build/setup-sles-repositories.sh \
    && zypper --non-interactive install --no-recommends \
       gcc make rpm-build cpio patch diffutils findutils tar gzip xz python3 \
       ca-certificates shadow coreutils grep util-linux

RUN --mount=from=nrpe_sles_media,target=/mnt/nrpe-sles-media,readonly \
    zypper --non-interactive install --no-recommends systemd-presets-branding-SLE util-linux-systemd

COPY scripts/sles_source.py /opt/nrpe-build/sles_source.py
COPY scripts/fetch_sles_packages.py /opt/nrpe-build/fetch_sles_packages.py
COPY packaging/sles15sp4-bootstrap.json /opt/nrpe-build/bootstrap.json
COPY packaging/sles15sp4-user-source.json /opt/nrpe-build/user-source.json
COPY scripts/build-sles-user.sh /opt/nrpe-build/build-sles-user.sh
RUN --mount=from=nrpe_sles_media,target=/mnt/nrpe-sles-media,readonly \
    python3 /opt/nrpe-build/fetch_sles_packages.py /opt/nrpe-build/bootstrap.json /tmp/nrpe-suse-rpms build \
    && zypper --non-interactive install --no-recommends /tmp/nrpe-suse-rpms/*.rpm \
    && bash /opt/nrpe-build/build-sles-user.sh \
    && rm -rf /tmp/nrpe-suse-rpms
COPY packaging/sles15sp4-source.json /opt/nrpe-build/source.json
RUN --mount=from=nrpe_sles_media,target=/mnt/nrpe-sles-media,readonly \
    python3 /opt/nrpe-build/sles_source.py /opt/nrpe-build/source.json /opt/nrpe-sources \
    && rpmspec --query --buildrequires /opt/nrpe-sources/nrpe.spec > /tmp/nrpe-build-requires \
    && while IFS= read -r requirement; do \
         zypper --non-interactive install --no-recommends "$requirement" || exit; \
       done < /tmp/nrpe-build-requires \
    && rm /tmp/nrpe-build-requires \
    && zypper clean --all

COPY scripts/build-sles.sh /opt/nrpe-build/build-sles.sh
RUN chmod 755 /opt/nrpe-build/build-sles.sh
ENTRYPOINT ["/opt/nrpe-build/build-sles.sh"]
